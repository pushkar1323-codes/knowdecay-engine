# ══════════════════════════════════════════════════════════════════════════════
# KnowDecay Engine — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and update values for your environment.
#   cp .env.example .env
#
# NEVER commit .env to version control — it may contain secrets.
# Generate a secure JWT secret:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=KnowDecay Engine
APP_VERSION=0.1.0
APP_ENV=development                    # development | testing | production

# ── Database ───────────────────────────────────────────────────────────────────
# Local Docker PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://knowdecay:knowdecay@localhost:5432/knowdecay

# ── Server ─────────────────────────────────────────────────────────────────────
# Production server settings (Gunicorn + Uvicorn ASGI workers)
HOST=0.0.0.0
PORT=8000
WORKERS=1                              # Recommended scaling: (2 × CPU cores) + 1

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG                        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                        # text (development) | json (production)

# ── Engine: Retention ─────────────────────────────────────────────────────────
DEFAULT_RETENTION_THRESHOLD=0.85       # Target recall probability before re-scheduling
BASE_DECAY_RATE=0.1                    # Base λ for Ebbinghaus forgetting curve
MIN_RETENTION_FLOOR=0.05               # Floor — prevents retention from reaching zero

# ── Engine: Priority ──────────────────────────────────────────────────────────
PRIORITY_EXAM_WEIGHT=1.5               # Maximum exam-proximity urgency multiplier
PRIORITY_DIFFICULTY_WEIGHT=1.2         # Difficulty modifier on urgency score
PRIORITY_URGENCY_WEIGHT=1.0            # Base urgency weight

# ── Infrastructure ────────────────────────────────────────────────────────────
CORS_ORIGINS=                          # Comma-separated origins, empty = disabled
TRUSTED_HOSTS=*                        # Future: trusted host validation middleware
REQUEST_TIMEOUT=30                     # Future: request timeout enforcement middleware
MAX_BATCH_SIZE=100                     # Max items in batch endpoints

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30         # Access token TTL in minutes
REFRESH_TOKEN_EXPIRE_DAYS=7            # Refresh token TTL in days
BCRYPT_ROUNDS=12                       # bcrypt cost factor (lower = faster, less secure)
REGISTRATION_ENABLED=true              # Allow public user registration

# ══════════════════════════════════════════════════════════════════════════════
# Future Configuration Hooks
# ══════════════════════════════════════════════════════════════════════════════
# These settings are placeholders for future services. They are not active.
# Uncomment and configure when the corresponding service is implemented.

# ── Future: Object Storage ────────────────────────────────────────────────────
# STORAGE_PROVIDER=                    # s3 | r2 | azure (empty = disabled)
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# ── Future: Background Workers ────────────────────────────────────────────────
# CELERY_BROKER_URL=                   # redis://localhost:6379/0
# CELERY_RESULT_BACKEND=              # redis://localhost:6379/1

# ── Future: Caching ──────────────────────────────────────────────────────────
# REDIS_URL=                           # redis://localhost:6379/0

# ── Future: Observability ─────────────────────────────────────────────────────
# OTEL_EXPORTER_ENDPOINT=             # OpenTelemetry collector endpoint
# SENTRY_DSN=                          # Sentry error tracking DSN

# ── Future: Email / Notifications ─────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# FROM_EMAIL=noreply@knowdecay.io
